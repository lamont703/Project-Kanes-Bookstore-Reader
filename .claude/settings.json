{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/git-staging-guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking git branch guard..."
          }
        ]
      }
    ]
  }
}
