meta {
  name: Get Book
  type: http
  seq: 2
}

get {
  url: {{supabase_url}}/rest/v1/books?id=eq.{{book_id}}&select=id,title,author,illustrator,description,genre,cover_image_url,series_name,series_order,is_age_restricted,status,book_variants(format,price,is_in_stock)
  body: none
  auth: none
}

headers {
  apikey: {{anon_key}}
  Content-Type: application/json
}

vars {
  book_id: <replace-with-book-uuid>
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Returns exactly one book", function() {
    expect(res.body).to.be.an("array").with.lengthOf(1);
  });
  test("Book has illustrator field", function() {
    expect(res.body[0]).to.have.property("illustrator");
  });
}
