meta {
  name: List Books
  type: http
  seq: 1
}

get {
  url: {{supabase_url}}/rest/v1/books?status=eq.published&select=id,title,author,illustrator,genre,cover_image_url,series_name,series_order,book_variants(format,price,is_in_stock)
  body: none
  auth: none
}

headers {
  apikey: {{anon_key}}
  Content-Type: application/json
}

query {
  genre: 
  search: 
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Returns an array", function() {
    expect(res.body).to.be.an("array");
  });
  test("Each book has variants", function() {
    if (res.body.length > 0) {
      expect(res.body[0]).to.have.property("book_variants");
    }
  });
}
