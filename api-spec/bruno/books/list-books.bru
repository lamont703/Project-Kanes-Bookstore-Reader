meta {
  name: List Books
  type: http
  seq: 1
}

get {
  url: {{base_url}}/rest/v1/books?genre&search
  body: none
  auth: none
}

params:query {
  genre: 
  search: 
}

headers {
  apikey: {{anon_key}}
  Content-Type: application/json
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Returns an array", function() {
    expect(res.body).to.be.an("array");
  });
  test("Each book has variants", function() {
    if (res.body.length > 0) {
      expect(res.body[0]).to.have.property("book_variants");
    }
  });
}
