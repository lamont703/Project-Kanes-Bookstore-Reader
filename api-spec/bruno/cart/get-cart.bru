meta {
  name: Get Cart
  type: http
  seq: 1
}

get {
  url: {{supabase_url}}/rest/v1/cart_items?select=id,book_id,variant_id,quantity,added_at,books(title,cover_image_url,author),book_variants(format,price,is_in_stock)
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

headers {
  apikey: {{anon_key}}
  Content-Type: application/json
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Returns an array", function() {
    expect(res.body).to.be.an("array");
  });
}
