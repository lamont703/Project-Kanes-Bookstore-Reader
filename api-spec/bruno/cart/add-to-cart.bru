meta {
  name: Add to Cart
  type: http
  seq: 2
}

post {
  url: {{supabase_url}}/rest/v1/cart_items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

headers {
  apikey: {{anon_key}}
  Content-Type: application/json
  Prefer: return=representation
}

body:json {
  {
    "book_id": "<replace-with-book-uuid>",
    "variant_id": "<replace-with-variant-uuid>",
    "quantity": 1
  }
}

tests {
  test("Status is 201", function() {
    expect(res.status).to.equal(201);
  });
  test("Conflict if ebook already in library: 409", function() {
    // Verify this returns 409 CONFLICT for owned ebooks
  });
}
