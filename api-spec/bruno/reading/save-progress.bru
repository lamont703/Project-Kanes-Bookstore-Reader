meta {
  name: Save Reading Progress
  type: http
  seq: 1
}

put {
  url: {{supabase_url}}/rest/v1/reading_progress
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

headers {
  apikey: {{anon_key}}
  Content-Type: application/json
  Prefer: resolution=merge-duplicates,return=representation
}

body:json {
  {
    "user_id": "<replace-with-user-uuid>",
    "book_id": "<replace-with-book-uuid>",
    "current_page": 5,
    "progress_percent": 50.00
  }
}

tests {
  test("Status is 200 or 201", function() {
    expect(res.status).to.be.oneOf([200, 201]);
  });
  test("Progress percent is valid range", function() {
    expect(res.body[0].progress_percent).to.be.within(0, 100);
  });
}
