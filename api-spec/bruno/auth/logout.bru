meta {
  name: Logout
  type: http
  seq: 3
}

post {
  url: {{supabase_url}}/auth/v1/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

headers {
  apikey: {{anon_key}}
}

tests {
  test("Status is 200 or 204", function() {
    expect(res.status).to.be.oneOf([200, 204]);
  });
}
